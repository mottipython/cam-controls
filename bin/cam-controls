class NonBlockingWorker:
    """Background worker to execute USB ioctls without freezing the UI."""
    def __init__(self):
        self.lock = threading.Lock()
        self.pending = {}  # (dev_path, cid) -> val
        self.cond = threading.Condition(self.lock)
        self.running = True
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def set_control_async(self, dev_path, cid, val):
        with self.cond:
            self.pending[(dev_path, cid)] = val
            self.cond.notify()

    def _run(self):
        while self.running:
            with self.cond:
                while not self.pending and self.running:
                    self.cond.wait(timeout=1.0)
                if not self.running:
                    break
                items = list(self.pending.items())
                self.pending.clear()

            for (dev_path, cid), val in items:
                execute_set_control(dev_path, cid, val)
                time.sleep(0.01)  # Gentle spacing to avoid USB bus congestion

worker = NonBlockingWorker()

def execute_set_control(dev_path, cid, val):
    """Open device, send ioctl, and close immediately."""
    try:
        fd = os.open(dev_path, os.O_RDWR)
        try:
            data = struct.pack('Ii', cid, int(val))
            fcntl.ioctl(fd, VIDIOC_S_CTRL, data)
            return True
        finally:
            os.close(fd)
    except OSError:
        return False

def query_control_single(dev_path, cid):
    """Safely query a single control value and range."""
    try:
        fd = os.open(dev_path, os.O_RDWR)
        try:
            query = struct.pack('II32siiiiIII', cid, 0, b'', 0, 0, 0, 0, 0, 0, 0)
            res = fcntl.ioctl(fd, VIDIOC_QUERYCTRL, query)
            _, qtype, name, qmin, qmax, qstep, qdef, qflags, _, _ = struct.unpack('II32siiiiIII', res)
            if (qflags & 1) or qtype not in (1, 2, 3):
                return None
            name_str = name.split(b'\x00')[0].decode('latin1').strip()
            ctrl = struct.pack('Ii', cid, 0)
            res_ctrl = fcntl.ioctl(fd, VIDIOC_G_CTRL, ctrl)
            _, val = struct.unpack('Ii', res_ctrl)
            return {"name": name_str, "type": qtype, "min": qmin, "max": qmax, "step": qstep, "default": qdef, "current": val}
        finally:
            os.close(fd)
    except OSError:
        return None

def list_capture_cameras():
    """Discover real video capture devices, resolving symlinks to stable nodes."""
    cameras = []
    # Check stable by-id symlinks first
    for link in sorted(glob.glob('/dev/v4l/by-id/*index0*')):
        try:
            real_dev = os.path.realpath(link)
            fd = os.open(real_dev, os.O_RDWR)
            try:
                cap = fcntl.ioctl(fd, VIDIOC_QUERYCAP, b'\x00' * 104)
                driver, card, bus, ver, caps, dev_caps, _, _, _ = struct.unpack('16s32s32sIIIIII', cap)
                eff_caps = dev_caps if (caps & V4L2_CAP_DEVICE_CAPS) else caps
                if eff_caps & V4L2_CAP_VIDEO_CAPTURE:
                    name = card.split(b'\x00')[0].decode('latin1', errors='replace').strip()
                    driver_name = driver.split(b'\x00')[0].decode('latin1', errors='replace').strip()
                    cameras.append({
                        "device": real_dev,
                        "name": name or f"Camera ({os.path.basename(real_dev)})",
                        "driver": driver_name
                    })
            finally:
                os.close(fd)
        except OSError:
            pass

    # If no by-id devices found, check standard /dev/video*
    if not cameras:
        for dev in sorted(glob.glob('/dev/video*')):
            try:
                fd = os.open(dev, os.O_RDWR)
                try:
                    cap = fcntl.ioctl(fd, VIDIOC_QUERYCAP, b'\x00' * 104)
                    driver, card, bus, ver, caps, dev_caps, _, _, _ = struct.unpack('16s32s32sIIIIII', cap)
                    eff_caps = dev_caps if (caps & V4L2_CAP_DEVICE_CAPS) else caps
                    if eff_caps & V4L2_CAP_VIDEO_CAPTURE:
                        name = card.split(b'\x00')[0].decode('latin1', errors='replace').strip()
                        driver_name = driver.split(b'\x00')[0].decode('latin1', errors='replace').strip()
                        cameras.append({
                            "device": dev,
                            "name": name or f"Camera ({os.path.basename(dev)})",
                            "driver": driver_name
                        })
                finally:
                    os.close(fd)
            except OSError:
                pass
    return cameras

def fix_pipewire():
    """Install 99-disable-libcamera.conf to bypass buggy libcamera UVC handler."""
    conf_dir = os.path.expanduser('~/.config/wireplumber/wireplumber.conf.d')
    os.makedirs(conf_dir, exist_ok=True)
    target = os.path.join(conf_dir, '99-disable-libcamera.conf')

    content = """# Generated by Camera Quick Controls
# Bypasses experimental libcamera UVC handler which causes garbled/green video
wireplumber.profiles = {
  main = {
    monitor.libcamera = "disabled"
  }
}
"""
    with open(target, 'w') as f:
        f.write(content)
    try:
        subprocess.run(["systemctl", "--user", "restart", "wireplumber", "pipewire"], check=False)
        return True, "WirePlumber configuration updated to bypass libcamera.\nPipeWire restarted!"
    except Exception as e:
        return True, f"Configuration written to {target}.\nPlease run 'systemctl --user restart wireplumber pipewire' to apply."

def fix_microphone():
    """Install 50-c310-mic.conf to lock C310 mic capture rate to 16000 Hz."""
    conf_dir = os.path.expanduser('~/.config/wireplumber/wireplumber.conf.d')
    os.makedirs(conf_dir, exist_ok=True)
    target = os.path.join(conf_dir, '50-c310-mic.conf')

    content = """# Generated by Camera Quick Controls
# Fixes the Logitech C310 16kHz microphone firmware bug (locks sample rate)
monitor.alsa.rules = [
  {
    matches = [
      {
        node.name = "~alsa_input.usb-.*046d.*"
      }
    ]
    actions = {
      update-props = {
        audio.rate = 16000
        audio.allowed-rates = [ 16000 ]
      }
    }
  }
]
"""
    with open(target, 'w') as f:
        f.write(content)
    try:
        subprocess.run(["systemctl", "--user", "restart", "wireplumber", "pipewire"], check=False)
        return True, "Microphone sample rate locked to 16000 Hz.\nPipeWire restarted!"
    except Exception as e:
        return True, f"Rule created at {target}.\nPlease run 'systemctl --user restart wireplumber pipewire'."

def save_startup_default(dev_path):
    """Save current camera settings to startup default file and enable autostart."""
    os.makedirs(CONFIG_DIR, exist_ok=True)
    cids_to_save = [
        CID_SATURATION, CID_CONTRAST, CID_BRIGHTNESS, CID_SHARPNESS,
        CID_GAIN, CID_WHITE_BALANCE_TEMP, CID_AUTO_WHITE_BALANCE,
        CID_EXPOSURE_AUTO, CID_EXPOSURE_ABSOLUTE, CID_POWER_LINE_FREQ
    ]
    saved_state = {}
    for cid in cids_to_save:
        info = query_control_single(dev_path, cid)
        if info:
            saved_state[str(cid)] = info["current"]

    with open(STARTUP_FILE, 'w') as f:
        json.dump(saved_state, f, indent=2)

    os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
    autostart_content = """[Desktop Entry]
Type=Application
Name=Camera Settings Restore
Comment=Restores saved camera settings on login
Exec=cam-controls --restore
Terminal=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-phase=2
"""
    with open(AUTOSTART_FILE, 'w') as f:
        f.write(autostart_content)

    return True, "Current settings saved as startup default.\nAutostart restore enabled!"

def restore_startup_defaults():
    """Silently apply startup defaults to all connected cameras."""
    if not os.path.exists(STARTUP_FILE):
        return
    try:
        with open(STARTUP_FILE) as f:
            saved_state = json.load(f)
    except Exception:
        return

    cameras = list_capture_cameras()
    for cam in cameras:
        for cid_str, val in saved_state.items():
            execute_set_control(cam["device"], int(cid_str), val)

def load_user_profiles():
    if os.path.exists(PROFILES_FILE):
        try:
            with open(PROFILES_FILE) as f:
                return json.load(f)
        except Exception:
            pass
    return {}

def save_user_profile(name, values):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    profiles = load_user_profiles()
    profiles[name] = {str(k): v for k, v in values.items()}
    with open(PROFILES_FILE, 'w') as f:
        json.dump(profiles, f, indent=2)

def delete_user_profile(name):
    profiles = load_user_profiles()
    if name in profiles:
        del profiles[name]
        with open(PROFILES_FILE, 'w') as f:
            json.dump(profiles, f, indent=2)

def print_status(dev_path):
    print(f"Camera Device: {dev_path} ({os.path.realpath(dev_path)})")
    print("-" * 65)
    for cid in [CID_SATURATION, CID_CONTRAST, CID_BRIGHTNESS, CID_SHARPNESS,
                CID_WHITE_BALANCE_TEMP, CID_AUTO_WHITE_BALANCE, CID_GAIN,
                CID_EXPOSURE_AUTO, CID_EXPOSURE_ABSOLUTE, CID_POWER_LINE_FREQ]:
        info = query_control_single(dev_path, cid)
        if info:
            print(f"{info['name']:25}: Current={info['current']:<5} (Min={info['min']}, Max={info['max']}, Default={info['default']})")

def run_gui(initial_dev=None):
    try:
        import tkinter as tk
        from tkinter import ttk, messagebox, simpledialog
    except ImportError:
        sys.stderr.write("Error: python3-tkinter is required for the GUI.\n")
        sys.exit(1)

    class CamApp:
        def __init__(self, root):
            self.root = root
            self.root.title("Camera Settings & Quick Controls")
            self.root.geometry("520x650")
            self.root.minsize(480, 580)

            try:
                self.icon = tk.PhotoImage(data=ICON_PNG_B64)
                self.root.iconphoto(True, self.icon)
            except Exception:
                pass

            self.current_dev = None
            self.slider_vars = {}
            self.debounce_timers = {}
            self.user_profiles = load_user_profiles()

            self.main_frame = ttk.Frame(root, padding=15)
            self.main_frame.pack(fill="both", expand=True)

            # Row 1: Camera Selector
            top_bar = ttk.Frame(self.main_frame)
            top_bar.pack(fill="x", pady=(0, 8))
            ttk.Label(top_bar, text="Camera:", font=("sans-serif", 9, "bold"), width=9).pack(side="left")
            self.cam_combo = ttk.Combobox(top_bar, state="readonly")
            self.cam_combo.pack(side="left", fill="x", expand=True, padx=4)
            self.cam_combo.bind("<<ComboboxSelected>>", self.on_camera_switch)
            ttk.Button(top_bar, text="↻", width=3, command=self.reload_cameras).pack(side="right")

            # Row 2: Preset Selector
            preset_bar = ttk.Frame(self.main_frame)
            preset_bar.pack(fill="x", pady=(0, 10))
            ttk.Label(preset_bar, text="Profile:", font=("sans-serif", 9, "bold"), width=9).pack(side="left")
            self.preset_combo = ttk.Combobox(preset_bar, state="readonly")
            self.preset_combo.pack(side="left", fill="x", expand=True, padx=4)
            self.preset_combo.bind("<<ComboboxSelected>>", self.on_preset_select)
            ttk.Button(preset_bar, text="Save As...", command=self.save_custom_preset).pack(side="right", padx=(2, 0))
            ttk.Button(preset_bar, text="Del", width=4, command=self.delete_custom_preset).pack(side="right")

            # Row 3: Quick Toggles (Auto WB, Auto Exposure, Anti-Flicker)
            toggles_box = ttk.LabelFrame(self.main_frame, text="Smart Adjustments & Lighting", padding=10)
            toggles_box.pack(fill="x", pady=(0, 8))

            t_left = ttk.Frame(toggles_box)
            t_left.pack(side="left", fill="x", expand=True)

            self.auto_wb_var = tk.BooleanVar(value=True)
            self.chk_auto_wb = ttk.Checkbutton(t_left, text="Auto White Balance", variable=self.auto_wb_var, command=self.toggle_auto_wb)
            self.chk_auto_wb.pack(anchor="w", pady=2)

            self.auto_exp_var = tk.BooleanVar(value=True)
            self.chk_auto_exp = ttk.Checkbutton(t_left, text="Auto Exposure", variable=self.auto_exp_var, command=self.toggle_auto_exp)
            self.chk_auto_exp.pack(anchor="w", pady=2)

            t_right = ttk.Frame(toggles_box)
            t_right.pack(side="right", fill="y")
            ttk.Label(t_right, text="Anti-Flicker:").pack(anchor="w")
            self.flicker_combo = ttk.Combobox(t_right, state="readonly", width=14, values=["Disabled", "50 Hz (EU/Asia)", "60 Hz (Americas)"])
            self.flicker_combo.pack(anchor="w", pady=2)
            self.flicker_combo.bind("<<ComboboxSelected>>", self.on_flicker_select)

            # Sliders Container Frame
            sliders_box = ttk.LabelFrame(self.main_frame, text="Manual Image Controls", padding=10)
            sliders_box.pack(fill="both", expand=True, pady=4)
            self.sliders_frame = ttk.Frame(sliders_box)
            self.sliders_frame.pack(fill="both", expand=True)

            # Row: Default Actions
            act_bar = ttk.Frame(self.main_frame)
            act_bar.pack(fill="x", pady=(8, 4))
            ttk.Button(act_bar, text="Reset Defaults", command=self.reset_defaults).pack(side="left")
            ttk.Button(act_bar, text="★ Save as Default", command=self.save_as_default).pack(side="left", padx=8)
            ttk.Button(act_bar, text="Apply Recommended", command=self.apply_recommended).pack(side="right")

            # Row: One-Click Linux System Fixes
            fixes_box = ttk.LabelFrame(self.main_frame, text="One-Click System Fixes", padding=8)
            fixes_box.pack(fill="x", pady=(6, 0))
            ttk.Button(fixes_box, text="🛡️ Fix Garbled / Green Video (PipeWire)", command=self.do_fix_pipewire).pack(fill="x", pady=2)
            ttk.Button(fixes_box, text="🎙️ Fix Robotic / Fast Microphone Audio (16kHz)", command=self.do_fix_microphone).pack(fill="x", pady=2)

            self.update_preset_list()
            self.reload_cameras(initial_dev)

        def update_preset_list(self):
            builtins = list(BUILTIN_PRESETS.keys())
            customs = [f"★ {k}" for k in self.user_profiles.keys()]
            all_presets = builtins + customs
            self.preset_combo['values'] = all_presets
            self.preset_combo.current(0)

        def reload_cameras(self, target_dev=None):
            self.cameras = list_capture_cameras()
            if not self.cameras:
                self.show_no_camera_error()
                return

            labels = [f"{c['name']}  ({c['device']})" for c in self.cameras]
            self.cam_combo['values'] = labels

            idx = 0
            if target_dev:
                for i, c in enumerate(self.cameras):
                    if c["device"] == target_dev or os.path.realpath(c["device"]) == os.path.realpath(target_dev):
                        idx = i
                        break
            elif self.current_dev:
                for i, c in enumerate(self.cameras):
                    if c["device"] == self.current_dev:
                        idx = i
                        break

            self.cam_combo.current(idx)
            self.load_camera(self.cameras[idx]["device"])

        def on_camera_switch(self, event=None):
            idx = self.cam_combo.current()
            if 0 <= idx < len(self.cameras):
                self.load_camera(self.cameras[idx]["device"])

        def load_camera(self, dev_path):
            self.current_dev = dev_path
            for widget in self.sliders_frame.winfo_children():
                widget.destroy()

            # Read auto-adjustments (safe, opens & closes immediately)
            awb_info = query_control_single(dev_path, CID_AUTO_WHITE_BALANCE)
            if awb_info:
                self.auto_wb_var.set(bool(awb_info["current"]))
                self.chk_auto_wb.state(["!disabled"])
            else:
                self.chk_auto_wb.state(["disabled"])

            aexp_info = query_control_single(dev_path, CID_EXPOSURE_AUTO)
            if aexp_info:
                self.auto_exp_var.set(aexp_info["current"] == 3)
                self.chk_auto_exp.state(["!disabled"])
            else:
                self.chk_auto_exp.state(["disabled"])

            freq_info = query_control_single(dev_path, CID_POWER_LINE_FREQ)
            if freq_info:
                self.flicker_combo.current(min(freq_info["current"], 2))
                self.flicker_combo.state(["!disabled"])
            else:
                self.flicker_combo.state(["disabled"])

            # Setup main sliders
            self.slider_vars = {}
            main_cids = [
                (CID_SATURATION, "Saturation"),
                (CID_CONTRAST, "Contrast"),
                (CID_BRIGHTNESS, "Brightness"),
                (CID_SHARPNESS, "Sharpness"),
                (CID_WHITE_BALANCE_TEMP, "White Balance"),
                (CID_EXPOSURE_ABSOLUTE, "Exposure Time"),
                (CID_GAIN, "Gain"),
            ]

            for cid, label in main_cids:
                info = query_control_single(dev_path, cid)
                if not info:
                    continue

                row = ttk.Frame(self.sliders_frame)
                row.pack(fill="x", pady=3)

                lbl = ttk.Label(row, text=f"{label}:", width=18, anchor="w")
                lbl.pack(side="left")

                val_lbl = ttk.Label(row, text=str(info["current"]), width=6, anchor="e")
                val_lbl.pack(side="right")

                scale = ttk.Scale(
                    row, from_=info["min"], to=info["max"], value=info["current"],
                    command=lambda val, c=cid, vl=val_lbl: self.on_slider_debounced(c, val, vl)
                )
                scale.pack(side="left", fill="x", expand=True, padx=8)
                self.slider_vars[cid] = (scale, val_lbl)

            self.update_slider_states()

        def update_slider_states(self):
            if CID_WHITE_BALANCE_TEMP in self.slider_vars:
                scale, _ = self.slider_vars[CID_WHITE_BALANCE_TEMP]
                scale.state(["disabled" if self.auto_wb_var.get() else "!disabled"])

            if CID_EXPOSURE_ABSOLUTE in self.slider_vars:
                scale, _ = self.slider_vars[CID_EXPOSURE_ABSOLUTE]
                scale.state(["disabled" if self.auto_exp_var.get() else "!disabled"])

        def on_slider_debounced(self, cid, val, label):
            val_int = int(float(val))
            label.config(text=str(val_int))
            # Debounce by 40ms to avoid flooding USB endpoint
            if cid in self.debounce_timers:
                self.root.after_cancel(self.debounce_timers[cid])
            self.debounce_timers[cid] = self.root.after(40, lambda: self.dispatch_control(cid, val_int))

        def dispatch_control(self, cid, val_int):
            if self.current_dev:
                worker.set_control_async(self.current_dev, cid, val_int)

        def toggle_auto_wb(self):
            if self.current_dev:
                worker.set_control_async(self.current_dev, CID_AUTO_WHITE_BALANCE, 1 if self.auto_wb_var.get() else 0)
                self.update_slider_states()

        def toggle_auto_exp(self):
            if self.current_dev:
                worker.set_control_async(self.current_dev, CID_EXPOSURE_AUTO, 3 if self.auto_exp_var.get() else 1)
                self.update_slider_states()

        def on_flicker_select(self, event=None):
            if self.current_dev:
                worker.set_control_async(self.current_dev, CID_POWER_LINE_FREQ, self.flicker_combo.current())

        def apply_values_dict(self, values_dict):
            if not self.current_dev:
                return
            for cid_key, val in values_dict.items():
                cid = int(cid_key)
                worker.set_control_async(self.current_dev, cid, val)
                if cid in self.slider_vars:
                    scale, lbl = self.slider_vars[cid]
                    scale.set(val)
                    lbl.config(text=str(val))
                elif cid == CID_AUTO_WHITE_BALANCE:
                    self.auto_wb_var.set(bool(val))
                elif cid == CID_EXPOSURE_AUTO:
                    self.auto_exp_var.set(val == 3)
                elif cid == CID_POWER_LINE_FREQ:
                    self.flicker_combo.current(min(val, 2))
            self.update_slider_states()

        def on_preset_select(self, event=None):
            name = self.preset_combo.get()
            if name in BUILTIN_PRESETS:
                self.apply_values_dict(BUILTIN_PRESETS[name])
            elif name.startswith("★ "):
                clean_name = name[2:]
                if clean_name in self.user_profiles:
                    self.apply_values_dict(self.user_profiles[clean_name])

        def save_custom_preset(self):
            from tkinter import simpledialog, messagebox
            name = simpledialog.askstring("Save Preset", "Enter a name for this preset:")
            if name:
                cur_values = {}
                for cid in self.slider_vars:
                    cur_values[cid] = int(float(self.slider_vars[cid][0].get()))
                cur_values[CID_AUTO_WHITE_BALANCE] = 1 if self.auto_wb_var.get() else 0
                cur_values[CID_EXPOSURE_AUTO] = 3 if self.auto_exp_var.get() else 1
                cur_values[CID_POWER_LINE_FREQ] = self.flicker_combo.current()

                save_user_profile(name, cur_values)
                self.user_profiles = load_user_profiles()
                self.update_preset_list()
                self.preset_combo.set(f"★ {name}")
                messagebox.showinfo("Preset Saved", f"Preset '{name}' saved successfully!")

        def delete_custom_preset(self):
            name = self.preset_combo.get()
            if not name.startswith("★ "):
                from tkinter import messagebox
                messagebox.showwarning("Cannot Delete", "Built-in presets cannot be deleted.")
                return
            clean_name = name[2:]
            delete_user_profile(clean_name)
            self.user_profiles = load_user_profiles()
            self.update_preset_list()

        def apply_recommended(self):
            self.apply_values_dict(BUILTIN_PRESETS["Recommended (Vivid)"])
            self.preset_combo.set("Recommended (Vivid)")

        def reset_defaults(self):
            if not self.current_dev:
                return
            for cid in [CID_SATURATION, CID_CONTRAST, CID_BRIGHTNESS, CID_SHARPNESS,
                        CID_GAIN, CID_WHITE_BALANCE_TEMP, CID_AUTO_WHITE_BALANCE,
                        CID_EXPOSURE_AUTO, CID_EXPOSURE_ABSOLUTE, CID_POWER_LINE_FREQ]:
                info = query_control_single(self.current_dev, cid)
                if info:
                    val = info["default"]
                    worker.set_control_async(self.current_dev, cid, val)
                    if cid in self.slider_vars:
                        scale, lbl = self.slider_vars[cid]
                        scale.set(val)
                        lbl.config(text=str(val))
                    elif cid == CID_AUTO_WHITE_BALANCE:
                        self.auto_wb_var.set(bool(val))
                    elif cid == CID_EXPOSURE_AUTO:
                        self.auto_exp_var.set(val == 3)
                    elif cid == CID_POWER_LINE_FREQ:
                        self.flicker_combo.current(min(val, 2))
            self.update_slider_states()

        def save_as_default(self):
            from tkinter import messagebox
            if not self.current_dev:
                return
            ok, msg = save_startup_default(self.current_dev)
            if ok:
                messagebox.showinfo("Saved as Startup Default", msg)
            else:
                messagebox.showerror("Error", msg)

        def do_fix_pipewire(self):
            from tkinter import messagebox
            ok, msg = fix_pipewire()
            messagebox.showinfo("PipeWire Video Fix", msg)

        def do_fix_microphone(self):
            from tkinter import messagebox
            ok, msg = fix_microphone()
            messagebox.showinfo("PipeWire Microphone Fix", msg)

        def show_no_camera_error(self):
            for widget in self.sliders_frame.winfo_children():
                widget.destroy()
            ttk.Label(self.sliders_frame, text="No camera devices detected.\nPlease check your USB connection.", foreground="red").pack(pady=20)

    root = tk.Tk()
    app = CamApp(root)
    root.mainloop()

def main():
    parser = argparse.ArgumentParser(description="Camera Quick Controls & Linux PipeWire Fix")
    parser.add_argument("-l", "--list-devices", action="store_true", help="List all detected camera devices")
    parser.add_argument("-d", "--device", help="Path to video device (e.g. /dev/video0) or camera index")
    parser.add_argument("--status", action="store_true", help="Print current camera control values")
    parser.add_argument("--apply-recommended", action="store_true", help="Apply recommended settings")
    parser.add_argument("--reset-defaults", action="store_true", help="Reset controls to hardware defaults")
    parser.add_argument("--save-default", action="store_true", help="Save current settings as startup default")
    parser.add_argument("--restore", action="store_true", help="Silently restore saved startup defaults (used on login)")
    parser.add_argument("--fix-pipewire", action="store_true", help="Fix garbled/green video by bypassing libcamera")
    parser.add_argument("--fix-mic", action="store_true", help="Fix robotic/fast microphone audio by locking 16kHz")
    parser.add_argument("--gui", action="store_true", help="Launch GUI control panel (default if no flags given)")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    args = parser.parse_args()

    if args.restore:
        restore_startup_defaults()
        return

    if args.fix_pipewire:
        ok, msg = fix_pipewire()
        print(msg)
        return

    if args.fix_mic:
        ok, msg = fix_microphone()
        print(msg)
        return

    cams = list_capture_cameras()

    if args.list_devices:
        if not cams:
            print("No video capture devices found.")
            return
        print(f"Found {len(cams)} video capture camera(s):")
        for i, c in enumerate(cams):
            print(f"  [{i}] {c['name']:30} -> {c['device']} ({c['driver']})")
        return

    # Resolve target device
    dev = None
    if args.device:
        if args.device.isdigit():
            idx = int(args.device)
            if 0 <= idx < len(cams):
                dev = cams[idx]["device"]
            else:
                sys.stderr.write(f"Error: Camera index {idx} out of range (found {len(cams)} cameras).\n")
                sys.exit(1)
        elif os.path.exists(args.device):
            dev = args.device
        else:
            sys.stderr.write(f"Error: Specified device {args.device} does not exist.\n")
            sys.exit(1)
    else:
        dev = cams[0]["device"] if cams else "/dev/video0"

    if args.save_default:
        ok, msg = save_startup_default(dev)
        print(msg)
        return

    if args.status:
        print_status(dev)
        return

    if args.apply_recommended:
        for cid, val in BUILTIN_PRESETS["Recommended (Vivid)"].items():
            execute_set_control(dev, cid, val)
        print(f"Recommended profile applied to {dev}!")
        return

    if args.reset_defaults:
        for cid in [CID_SATURATION, CID_CONTRAST, CID_BRIGHTNESS, CID_SHARPNESS, CID_GAIN]:
            info = query_control_single(dev, cid)
            if info:
                execute_set_control(dev, cid, info["default"])
        print(f"Defaults restored on {dev}!")
        return

    # Default to GUI
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY") or args.gui:
        run_gui(dev)
    else:
        print_status(dev)

if __name__ == "__main__":
    main()
