#!/usr/bin/env python3
"""
Camera Quick Controls & Linux PipeWire Fix
Adjusts webcam controls (saturation, contrast, brightness, white balance)
and provides quick fixes for washed-out colors and PipeWire libcamera video distortion.
"""

import os
import sys
import glob
import fcntl
import struct
import argparse
import subprocess

VERSION = "1.0.0"

# V4L2 ioctl codes
VIDIOC_QUERYCTRL = 0xc0445624
VIDIOC_G_CTRL    = 0xc008561b
VIDIOC_S_CTRL    = 0xc008561c

# V4L2 Control IDs
CTRLS = {
    "brightness":   {"cid": 0x00980900, "name": "Brightness",          "default_rec": 128},
    "contrast":     {"cid": 0x00980901, "name": "Contrast",            "default_rec": 42},
    "saturation":   {"cid": 0x00980902, "name": "Saturation",          "default_rec": 56},
    "sharpness":    {"cid": 0x0098091b, "name": "Sharpness",           "default_rec": 28},
    "gain":         {"cid": 0x00980913, "name": "Gain",                "default_rec": 32},
    "white_balance":{"cid": 0x0098091a, "name": "White Balance Temp",  "default_rec": 4500},
}

def find_camera_device(requested_dev=None):
    if requested_dev:
        if os.path.exists(requested_dev):
            return requested_dev
        else:
            sys.stderr.write(f"Error: Specified device {requested_dev} does not exist.\n")
            sys.exit(1)

    # 1. Prefer Logitech / known UVC camera index 0 symlinks
    by_id = sorted(glob.glob('/dev/v4l/by-id/*index0*'))
    if by_id:
        return by_id[0]

    # 2. Check standard device nodes
    for dev in ['/dev/video1', '/dev/video0', '/dev/video2']:
        if os.path.exists(dev):
            return dev

    return '/dev/video0'

def query_control(fd, cid):
    query = struct.pack('II32siiiiIII', cid, 0, b'', 0, 0, 0, 0, 0, 0, 0)
    try:
        res = fcntl.ioctl(fd, VIDIOC_QUERYCTRL, query)
        _, _, name, qmin, qmax, qstep, qdef, _, _, _ = struct.unpack('II32siiiiIII', res)
        name_str = name.split(b'\x00')[0].decode('latin1')
        ctrl = struct.pack('Ii', cid, 0)
        res_ctrl = fcntl.ioctl(fd, VIDIOC_G_CTRL, ctrl)
        _, val = struct.unpack('Ii', res_ctrl)
        return {"name": name_str, "min": qmin, "max": qmax, "step": qstep, "default": qdef, "current": val}
    except OSError:
        return None

def set_control(fd, cid, val):
    data = struct.pack('Ii', cid, int(val))
    try:
        fcntl.ioctl(fd, VIDIOC_S_CTRL, data)
        return True
    except OSError as e:
        return False

def fix_pipewire():
    """Install 99-disable-libcamera.conf to fix PipeWire libcamera UVC issues."""
    conf_dir = os.path.expanduser('~/.config/wireplumber/wireplumber.conf.d')
    os.makedirs(conf_dir, exist_ok=True)
    target = os.path.join(conf_dir, '99-disable-libcamera.conf')

    content = """# Generated by Camera Quick Controls
# Bypasses the experimental libcamera UVC handler which causes garbled/green video
wireplumber.profiles = {
  main = {
    monitor.libcamera = "disabled"
  }
}
"""
    with open(target, 'w') as f:
        f.write(content)
    print(f"Created WirePlumber config: {target}")

    try:
        subprocess.run(["systemctl", "--user", "restart", "wireplumber", "pipewire"], check=False)
        print("Restarted WirePlumber and PipeWire user services.")
    except Exception:
        print("Note: Please run 'systemctl --user restart wireplumber pipewire' to apply changes.")

def print_status(dev_path):
    try:
        fd = os.open(dev_path, os.O_RDWR)
    except Exception as e:
        print(f"Failed to open {dev_path}: {e}")
        return

    print(f"Camera Device: {dev_path} ({os.path.realpath(dev_path)})")
    print("-" * 65)
    for key, item in CTRLS.items():
        info = query_control(fd, item["cid"])
        if info:
            print(f"{info['name']:25}: Current={info['current']:<5} (Min={info['min']}, Max={info['max']}, Default={info['default']})")
    os.close(fd)

def apply_recommended_cli(dev_path):
    try:
        fd = os.open(dev_path, os.O_RDWR)
    except Exception as e:
        print(f"Failed to open {dev_path}: {e}")
        return

    print(f"Applying recommended settings to {dev_path}...")
    for key, item in CTRLS.items():
        val = item["default_rec"]
        success = set_control(fd, item["cid"], val)
        status = "OK" if success else "FAILED"
        print(f"  {item['name']:20} -> {val:<5} [{status}]")
    os.close(fd)
    print("Done! Recommended profile applied.")

def reset_defaults_cli(dev_path):
    try:
        fd = os.open(dev_path, os.O_RDWR)
    except Exception as e:
        print(f"Failed to open {dev_path}: {e}")
        return

    print(f"Resetting {dev_path} to hardware defaults...")
    for key, item in CTRLS.items():
        info = query_control(fd, item["cid"])
        if info:
            set_control(fd, item["cid"], info["default"])
            print(f"  {info['name']:20} -> {info['default']:<5} [OK]")
    os.close(fd)
    print("Done! Defaults restored.")

def run_gui(dev_path):
    try:
        import tkinter as tk
        from tkinter import ttk, messagebox
    except ImportError:
        sys.stderr.write("Error: python3-tkinter is required to launch the GUI.\n")
        sys.stderr.write("Install it with: sudo apt install python3-tk  OR  sudo dnf install python3-tkinter\n")
        sys.exit(1)

    class CamApp:
        def __init__(self, root):
            self.root = root
            self.root.title("Camera Quick Controls")
            self.root.geometry("460x450")
            self.root.minsize(420, 420)
            
            try:
                self.fd = os.open(dev_path, os.O_RDWR)
            except Exception as e:
                err_frame = ttk.Frame(root, padding=20)
                err_frame.pack(fill="both", expand=True)
                ttk.Label(err_frame, text=f"Could not open camera device:\n{dev_path}", font=("sans-serif", 11, "bold"), foreground="red").pack(pady=10)
                ttk.Label(err_frame, text=f"Details: {e}", wraplength=380).pack(pady=5)
                return

            frame = ttk.Frame(root, padding=15)
            frame.pack(fill="both", expand=True)

            header = ttk.Frame(frame)
            header.pack(fill="x", pady=(0, 15))
            
            real_name = os.path.basename(os.path.realpath(dev_path))
            ttk.Label(header, text="Webcam Quick Controls", font=("sans-serif", 13, "bold")).pack(anchor="w")
            ttk.Label(header, text=f"Active device: {dev_path} ({real_name})", foreground="gray").pack(anchor="w")

            self.slider_vars = {}
            for key, item in CTRLS.items():
                cid = item["cid"]
                info = query_control(self.fd, cid)
                if not info:
                    continue

                row = ttk.Frame(frame)
                row.pack(fill="x", pady=4)

                lbl = ttk.Label(row, text=f"{item['name']}:", width=18, anchor="w")
                lbl.pack(side="left")

                val_lbl = ttk.Label(row, text=str(info["current"]), width=6, anchor="e")
                val_lbl.pack(side="right")

                scale = ttk.Scale(
                    row, from_=info["min"], to=info["max"], value=info["current"],
                    command=lambda val, c=cid, vl=val_lbl: self.on_slider(c, val, vl)
                )
                scale.pack(side="left", fill="x", expand=True, padx=8)
                self.slider_vars[cid] = (scale, val_lbl)

            btn_frame = ttk.Frame(frame)
            btn_frame.pack(fill="x", pady=(20, 0))

            ttk.Button(btn_frame, text="Reset to Defaults", command=self.reset_defaults).pack(side="left")
            ttk.Button(btn_frame, text="Apply Recommended", command=self.apply_recommended).pack(side="right")

            fix_frame = ttk.Frame(frame)
            fix_frame.pack(fill="x", pady=(15, 0))
            ttk.Button(fix_frame, text="Fix Garbled/Green Video (PipeWire)", command=self.do_fix_pipewire).pack(fill="x")

        def on_slider(self, cid, val, label):
            val_int = int(float(val))
            label.config(text=str(val_int))
            set_control(self.fd, cid, val_int)

        def apply_recommended(self):
            for key, item in CTRLS.items():
                cid = item["cid"]
                val = item["default_rec"]
                set_control(self.fd, cid, val)
                if cid in self.slider_vars:
                    scale, lbl = self.slider_vars[cid]
                    scale.set(val)
                    lbl.config(text=str(val))

        def reset_defaults(self):
            for key, item in CTRLS.items():
                cid = item["cid"]
                info = query_control(self.fd, cid)
                if info:
                    set_control(self.fd, cid, info["default"])
                    if cid in self.slider_vars:
                        scale, lbl = self.slider_vars[cid]
                        scale.set(info["default"])
                        lbl.config(text=str(info["default"]))

        def do_fix_pipewire(self):
            fix_pipewire()
            from tkinter import messagebox
            messagebox.showinfo("PipeWire Fix Applied", "WirePlumber configuration has been updated to bypass libcamera.\nPipeWire services restarted!")

    root = tk.Tk()
    app = CamApp(root)
    root.mainloop()

def main():
    parser = argparse.ArgumentParser(description="Camera Quick Controls & Linux PipeWire Fix")
    parser.add_argument("-d", "--device", help="Path to video device (e.g. /dev/video1)")
    parser.add_argument("--status", action="store_true", help="Print current camera control values")
    parser.add_argument("--apply-recommended", action="store_true", help="Apply recommended settings (vivid colors, balanced contrast)")
    parser.add_argument("--reset-defaults", action="store_true", help="Reset controls to hardware defaults")
    parser.add_argument("--fix-pipewire", action="store_true", help="Apply WirePlumber fix to eliminate garbled/green video on PipeWire")
    parser.add_argument("--gui", action="store_true", help="Launch GUI control panel (default if no flags given)")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    args = parser.parse_args()
    dev = find_camera_device(args.device)

    if args.fix_pipewire:
        fix_pipewire()
        return

    if args.status:
        print_status(dev)
        return

    if args.apply_recommended:
        apply_recommended_cli(dev)
        return

    if args.reset_defaults:
        reset_defaults_cli(dev)
        return

    # Default to GUI if graphical environment is detected
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY") or args.gui:
        run_gui(dev)
    else:
        print_status(dev)

if __name__ == "__main__":
    main()
